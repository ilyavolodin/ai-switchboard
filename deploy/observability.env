# docker compose -f deploy/docker-compose.yml --env-file deploy/observability.env up -d
#
# Starts the `observability` profile (grafana/otel-lgtm) and sends Switchboard's traces, metrics
# and logs to it over OTLP/HTTP. Grafana: http://localhost:3000 (dashboard "AI Switchboard").
COMPOSE_PROFILES=observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
