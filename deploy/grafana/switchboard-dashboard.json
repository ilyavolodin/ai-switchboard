{
  "annotations": {
    "list": []
  },
  "description": "AI Switchboard: events, dispatch, batches, runs, meters, budgets, breakers and plugin health from the /metrics endpoint or an OTLP → Prometheus pipeline, plus its OTLP logs (Loki) and traces (Tempo).",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Runbook",
      "type": "link",
      "url": "https://github.com/ai-switchboard/switchboard/blob/main/docs/runbook.md",
      "targetBlank": true
    },
    {
      "title": "Traces (Tempo)",
      "type": "link",
      "targetBlank": true,
      "url": "/explore?schemaVersion=1&panes=%7B%22t%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7Bresource.service.name%3D%5C%22switchboard%5C%22%20%26%26%20name%3D%5C%22switchboard.ingest%5C%22%7D%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D",
      "tooltip": "Every ingested delivery as one trace, in Explore"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Live replicas",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "description": "Replicas whose 30 s heartbeat advanced in the last 2 minutes.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(increase(switchboard_heartbeat_total[2m]) > 0) or vector(0)",
          "legendFormat": "",
          "instant": true
        }
      ]
    },
