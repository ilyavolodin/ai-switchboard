{
  "name": "@ai-switchboard/source-webhook",
  "version": "1.1.0",
  "description": "Generic webhook source: one event per delivery with no setup, fields picked by path, or a JSONata mapping.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "switchboard-plugin"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "switchboard": {
    "entry": "./dist/plugin.js",
    "source": "./src/plugin.ts",
    "sdk": "^1.4.0"
  },
  "exports": {
    ".": {
      "@ai-switchboard/source": "./src/plugin.ts",
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@ai-switchboard/sdk": "^1.4.0"
  },
  "devDependencies": {
    "@ai-switchboard/sdk": "workspace:^"
  },
  "dependencies": {
    "jsonata": "^2.2.2"
  }
}
