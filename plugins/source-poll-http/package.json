{
  "name": "@ai-switchboard/source-poll-http",
  "version": "1.0.0",
  "description": "Polls a JSON endpoint with a cursor and maps items with JSONata.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "switchboard-plugin"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "switchboard": {
    "entry": "./dist/plugin.js",
    "source": "./src/plugin.ts",
    "sdk": "^2.4.0"
  },
  "exports": {
    ".": {
      "@ai-switchboard/source": "./src/plugin.ts",
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./schemas": {
      "@ai-switchboard/source": "./src/schemas.ts",
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@ai-switchboard/sdk": "^2.4.0"
  },
  "devDependencies": {
    "@ai-switchboard/sdk": "workspace:^"
  },
  "dependencies": {
    "jsonata": "^2.2.2"
  }
}
