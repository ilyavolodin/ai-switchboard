{
  "name": "@ai-switchboard/sdk",
  "version": "2.0.0",
  "description": "Interfaces, definePlugin, HttpClient and the conformance kit for AI Switchboard plugins.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@ai-switchboard/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@ai-switchboard/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./icons": {
      "@ai-switchboard/source": "./src/icons.ts",
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
